# ---------------------------------------------------------------------------
# Flaming Chariot Outreach — environment configuration
# The web installer (/install) fills in the essentials. Never commit .env.
# ---------------------------------------------------------------------------
APP_NAME="Flaming Chariot Outreach"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_INSTALLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_DISPLAY_TIMEZONE=Africa/Lagos

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database — MySQL/MariaDB on most shared hosts (cPanel → MySQL Databases).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# File-based sessions/cache work everywhere; switch to redis on a VPS if available.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Set to true once the site is served over HTTPS (the installer does this for https:// URLs).
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax
CACHE_STORE=file

# The queue is processed by the scheduler cron (see docs/SHARED_HOSTING.md).
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# Behind Cloudflare or a load balancer set TRUSTED_PROXIES=*
TRUSTED_PROXIES=

# Mail — use the SMTP account from your hosting panel or a transactional provider.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
# Optional shared inbox copied on staff alerts (alerts never contain counselling details).
STAFF_NOTIFICATION_EMAIL=

# Security
REQUIRE_STAFF_MFA=false
INSTALLER_ENABLED=true

# Streaming — embeds work without a key; the key enables automatic live status.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
STREAM_EMBED_HOSTS=stream.mux.com,cloudflarestream.com,videodelivery.net,facebook.com

# Payments: paystack | flutterwave (the "test" gateway is disabled in production)
PAYMENT_PROVIDER=paystack
PAYMENT_FALLBACK_EMAIL=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCIES=NGN
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_CURRENCIES=NGN,USD
DONATION_MIN_MINOR=10000

# SMS: log | termii | twilio | none      WhatsApp: log | whatsapp_cloud | twilio | none
SMS_DRIVER=none
WHATSAPP_DRIVER=none
TERMII_API_KEY=
TERMII_SENDER_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Newsletter provider sync: none | mailchimp | brevo
NEWSLETTER_PROVIDER=none
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
BREVO_API_KEY=
BREVO_LIST_ID=

# Analytics (optional, privacy-friendly script such as Plausible)
ANALYTICS_SCRIPT_URL=
ANALYTICS_DOMAIN=
CSP_EXTRA_SCRIPT_SRC=
CSP_EXTRA_CONNECT_SRC=

# Backups (php artisan fco:backup runs nightly via the scheduler)
BACKUP_PASSWORD=
BACKUP_KEEP=14
BACKUP_INCLUDE_MEDIA=false

# Data retention (days)
RETENTION_COUNSELLING_DAYS=730
RETENTION_APPOINTMENT_DAYS=365
RETENTION_ENQUIRY_DAYS=365
